# LLM Provider Configuration
# Choose: openrouter or opencode
LLM_PROVIDER=openrouter

# OpenRouter settings
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=ling-3.0

# OpenCode settings (if using OpenCode provider)
OPENCODE_API_KEY=your-opencode-api-key-here
OPENCODE_MODEL=opencode-default

# Request timeout in seconds
MODEL_TIMEOUT=30

# Challenge workspace directory (relative to project root)
CTF_WORKSPACE=challenges

# Maximum number of agent tool-execution steps per request
MAX_AGENT_STEPS=10

# Timeout in seconds for command execution tools
TOOL_TIMEOUT_SECONDS=30

# Maximum output characters per tool result
MAX_TOOL_OUTPUT_CHARS=4096

# HTTP tool security (defaults are restrictive)
# Set to true only for local lab/authorized targets
ALLOW_LOCALHOST_TARGETS=false
ALLOW_PRIVATE_TARGETS=false
HTTP_TIMEOUT_SECONDS=10
MAX_HTTP_BODY_CHARS=3000
MAX_REDIRECTS=5
HTTP_USER_AGENT=CTF-Agent/1.0 (educational; authorized targets only)

# Skill system
SKILLS_DIRECTORY=skills
ENABLE_SKILLS=true
MAX_ACTIVE_SKILLS=5
MAX_SKILL_CONTEXT_CHARS=4000
SKILL_AUTO_SELECTION=true
SKILL_MIN_SCORE=0.3

# Skill sync (GitHub repository)
# Set to a repository URL to enable: python main.py --sync-skills
SKILLS_REPOSITORY_URL=
SKILLS_REPOSITORY_BRANCH=main
SKILLS_SYNC_DIRECTORY=skills/downloaded

# Stage 6: Autonomous reasoning
# Master switch for planning, evidence logging, memory, and structured reports
ENABLE_AUTONOMOUS_MODE=true
# Maximum retries for transient tool failures (timeouts/network errors)
MAX_TOOL_RETRIES=2
# Delay in seconds between tool retries
TOOL_RETRY_DELAY_SECONDS=0.5
# Session memory master switch
ENABLE_SESSION_MEMORY=true
# Maximum evidence entries kept per session
MAX_EVIDENCE_ENTRIES=200

# Stage 7: Specialist workflows (CTF specialist knowledge)
# Master switch for specialist modules and the specialist router
ENABLE_SPECIALISTS=true
# Minimum relevance score for a specialist to be suggested (0..1)
SPECIALIST_MIN_SCORE=0.25
# Maximum specialists suggested per selection
MAX_SPECIALIST_SUGGESTIONS=3

# Stage 7: Resource limits (prevent slow/endless runs)
# Maximum explicit specialist executions per challenge
MAX_SPECIALIST_CALLS=12
# Maximum HTTP requests per challenge
MAX_HTTP_REQUESTS=40
# Maximum command executions per challenge
MAX_COMMAND_EXECUTIONS=30
# Maximum identical actions within the duplicate window
MAX_DUPLICATE_ACTIONS=3
# Duplicate-action detection window in seconds
DUPLICATE_ACTION_WINDOW=90
# Global challenge timeout in seconds (0 = disabled)
GLOBAL_CHALLENGE_TIMEOUT_SECONDS=1800

# Stage 7: Optional pwntools integration (spec 9)
# Requires: pip install pwntools
ENABLE_PWNTOOLS=false
